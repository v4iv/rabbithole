---
import HeroImage from "@/assets/hero.svg"
import Navbar from "@/components/Navbar.astro"
import Layout from "@/layouts/Layout.astro"
import Links from "@/components/Links.astro"
import {
  getLangFromUrl,
  useTranslations,
  // useTranslatedPath,
} from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
// const translatePath = useTranslatedPath(lang)
---

<Layout>
  <main class="relative min-h-screen min-h-svh min-h-dvh overflow-x-hidden pb-[env(safe-area-inset-bottom,0px)]">
    <!-- Ambient watercolor cursor glow -->
    <div
      class="cursor-glow pointer-events-none fixed inset-0 z-0 opacity-0"
      aria-hidden="true"
    ></div>

    <Navbar />

    <!-- HERO SECTION -->
    <section
      id="hero"
      class="hero-section relative z-10 flex min-h-screen min-h-svh min-h-dvh flex-col items-center justify-center pb-24 sm:pb-28"
    >
      <div class="hero-container relative container mx-auto p-5 will-change-transform">
        <!-- hero logo -->
        <HeroImage class="hero-svg w-full select-none" />

        <!-- subtitle with link to Eshale's about page -->
        <div class="hero-subtitle mt-5 flex items-start justify-end">
          {t("signature-by")}&nbsp;
          <a
            href="https://instagram.com/its_eshale"
            target="blank"
            rel="noopener nofollow"
            class="signature-link group flex items-start gap-1 cursor-pointer"
            aria-label="About Eshale"
          >
            <span class="signature-text border-b border-dashed font-serif text-2xl italic transition-colors hover:text-teal-400">
              {t("signature-name")}
            </span>
            <svg
              class="signature-arrow size-3 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              role="presentation"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M9.996 1.532l.008 1 2.779-.022-4.136 4.136.707.707 4.136-4.136-.023 2.779 1 .008.037-4.508-4.508.036z"></path>
              <path d="M12 12H4V4h4.5V3h-5l-.5.5v9l.5.5h9l.5-.5v-5h-1V12z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Hero Bottom Bar: Social Links Dock -->
      <div class="hero-bottom-bar pointer-events-none absolute bottom-[calc(2.2rem+env(safe-area-inset-bottom,0px))] z-30 flex w-full items-center justify-center px-6 sm:bottom-10 sm:px-12">
        <div class="pointer-events-auto">
          <Links />
        </div>
      </div>
    </section>

    <!-- credits -->
    <footer class="page-footer pointer-events-none absolute right-4 sm:right-6 bottom-[calc(0.5rem+env(safe-area-inset-bottom,0px))] z-20 flex w-full justify-end px-2">
      <a
        href="https://waybove.pages.dev"
        class="pointer-events-auto font-mono text-xs lowercase text-neutral-600 hover:text-neutral-950 transition-colors"
        target="_blank"
        rel="noopener nofollow"
      >
        designed by&nbsp;
        <span class="font-bold text-blue-900 hover:border-b hover:border-dotted">
          vaibhav
        </span>
      </a>
    </footer>
  </main>
</Layout>

<script src="@/scripts/animations.ts"></script>
