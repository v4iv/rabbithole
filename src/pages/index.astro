---
import HeroImage from "@/assets/hero.svg"
import Layout from "@/layouts/Layout.astro"
import Links from "@/components/Links.astro"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout>
  <main class="relative">
    <div class="flex min-h-screen items-center justify-center">
      <div class="relative container mx-auto p-5">
        <!-- hero -->
        <HeroImage />

        <!-- subtitle -->
        <div class="mt-5 flex items-start justify-end">
          {t("signature.by")}&nbsp;<a
            target="_blank"
            href="https://instagram.com/its_eshale"
            rel="noopener nofollow"
            class="border-b border-dashed font-serif text-2xl italic hover:text-teal-400"
          >
            {t("signature.name")}
          </a>
        </div>
      </div>
    </div>

    <!-- links -->
    <Links />
  </main>
</Layout>
