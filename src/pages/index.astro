---
import HeroImage from "@/assets/hero.svg"
import Navbar from "@/components/Navbar.astro"
import Layout from "@/layouts/Layout.astro"
import Links from "@/components/Links.astro"
import Catalogue from "@/components/Catalogue.astro"
import Colophon from "@/components/Colophon.astro"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout>
  <main class="relative min-h-screen min-h-svh min-h-dvh overflow-x-hidden">
    <!-- Ambient watercolor cursor glow -->
    <div
      class="cursor-glow pointer-events-none fixed inset-0 z-0 opacity-0"
      aria-hidden="true"
    ></div>

    <Navbar />

    <!-- HERO SECTION -->
    <section
      id="hero"
      class="hero-section relative z-10 flex min-h-screen min-h-svh min-h-dvh flex-col items-center justify-center pb-24 sm:pb-28"
    >
      <div class="hero-container relative container mx-auto p-5 will-change-transform">
        <!-- hero logo -->
        <HeroImage class="hero-svg w-full select-none" />

        <!-- subtitle -->
        <div class="hero-subtitle mt-5 flex items-start justify-end">
          {t("signature-by")}&nbsp;
          <a
            target="_blank"
            href="https://instagram.com/its_eshale"
            rel="noopener nofollow"
            class="signature-link group flex items-start gap-1"
          >
            <span class="signature-text border-b border-dashed font-serif text-2xl italic transition-colors hover:text-teal-400">
              {t("signature-name")}
            </span>
            <svg
              class="signature-arrow size-3 transition-transform"
              role="presentation"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M9.996 1.532l.008 1 2.779-.022-4.136 4.136.707.707 4.136-4.136-.023 2.779 1 .008.037-4.508-4.508.036z"></path>
              <path d="M12 12H4V4h4.5V3h-5l-.5.5v9l.5.5h9l.5-.5v-5h-1V12z"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Hero Bottom Bar: Scroll Cue & Social Links Dock -->
      <div class="hero-bottom-bar pointer-events-none absolute bottom-[calc(1.25rem+env(safe-area-inset-bottom,0px))] z-30 flex w-full flex-col items-center justify-between gap-4 px-6 sm:bottom-8 sm:flex-row sm:px-12">
        <a
          href="#catalogue"
          class="catalogue-scroll-cue pointer-events-auto group flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-neutral-600 transition-colors hover:text-neutral-950"
        >
          <span class="inline-block size-1.5 rounded-full bg-purple-500 transition-transform group-hover:scale-150"></span>
          <span>{t("explore-catalogue")}</span>
          <span class="cue-arrow inline-block transition-transform group-hover:translate-y-1">
            ↓
          </span>
        </a>

        <div class="pointer-events-auto">
          <Links />
        </div>

        <div class="hidden font-mono text-xs uppercase tracking-widest text-neutral-400 sm:block">
          {t("issue-tag")}
        </div>
      </div>
    </section>

    <!-- CATALOGUE / GALLERY SECTION -->
    <Catalogue />

    <!-- COLOPHON / FOOTER DIRECTORY -->
    <Colophon />
  </main>
</Layout>

<script src="@/scripts/animations.ts"></script>
