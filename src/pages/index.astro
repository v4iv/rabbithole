---
import HeroImage from "@/assets/hero.svg"
import Navbar from "@/components/Navbar.astro"
import Layout from "@/layouts/Layout.astro"
import Links from "@/components/Links.astro"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout>
  <main class="relative">
    <Navbar />
    <section class="flex min-h-screen items-center justify-center">
      <div class="relative container mx-auto p-5">
        <!-- hero -->
        <HeroImage />

        <!-- subtitle -->
        <div class="mt-5 flex items-start justify-end">
          {t("signature-by")}&nbsp;<a
            target="_blank"
            href="https://instagram.com/its_eshale"
            rel="noopener nofollow"
            class="flex items-start gap-1"
          >
            <span
              class="border-b border-dashed font-serif text-2xl italic hover:text-teal-400"
              >{t("signature-name")}</span
            >
            <svg
              class="size-3"
              role="presentation"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 16 16"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M9.996 1.532l.008 1 2.779-.022-4.136 4.136.707.707 4.136-4.136-.023 2.779 1 .008.037-4.508-4.508.036z"
              ></path>
              <path d="M12 12H4V4h4.5V3h-5l-.5.5v9l.5.5h9l.5-.5v-5h-1V12z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </section>
    <!-- links -->
    <Links />
    <!-- credits -->
    <footer class="absolute right-5 bottom-0.5 flex w-full justify-end">
      <a
        href="https://waybove.pages.dev"
        class="font-mono text-xs lowercase"
        target="_blank"
        rel="noopener nofollow"
      >
        designed by&nbsp;<span
          class="font-bold text-blue-900 hover:border-b hover:border-dotted"
          >vaibhav</span
        >
      </a>
    </footer>
  </main>
</Layout>
