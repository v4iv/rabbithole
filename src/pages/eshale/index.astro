---
import Layout from "@/layouts/Layout.astro"
import EditorialHeader from "@/components/EditorialHeader.astro"
import Bio from "@/components/Bio.astro"
import Catalogue from "@/components/Catalogue.astro"
import Couture from "@/components/Couture.astro"
import Colophon from "@/components/Colophon.astro"
import FashionModal from "@/components/FashionModal.astro"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<Layout title={`${t("about-eshale-title")} — ${t("about-eshale-subtitle")}`}>
  <main class="relative min-h-screen overflow-x-hidden bg-[#faf9f6]">
    <!-- Ambient watercolor cursor glow -->
    <div
      class="cursor-glow pointer-events-none fixed inset-0 z-0 opacity-0"
      aria-hidden="true"
    ></div>

    <!-- Editorial Header Navigation -->
    <EditorialHeader />

    <!-- Bio & Ethereal Artist Profile Section -->
    <Bio />

    <!-- Volume I: Artworks & Ceramics Catalogue Section -->
    <Catalogue />

    <!-- Volume II: Couture & Wearable Art Section -->
    <Couture />

    <!-- Colophon Directory & Inquiries Section -->
    <Colophon />
  </main>

  <!-- Couture Detail Lightbox Modal -->
  <FashionModal />
</Layout>

<script src="@/scripts/animations.ts"></script>
