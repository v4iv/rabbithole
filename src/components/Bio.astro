---
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro"
import * as bioDoc from "@/content/bio.md"
import type { BioFrontmatter } from "@/types/bio"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const bio: BioFrontmatter = (bioDoc as any).frontmatter as BioFrontmatter

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/img/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
)

function resolveImage(pathOrFilename?: string): ImageMetadata | undefined {
  if (!pathOrFilename) return undefined
  if (imageModules[pathOrFilename]) return imageModules[pathOrFilename].default
  const normalized = pathOrFilename
    .replace(/^@\//, "/src/")
    .replace(/^src\//, "/src/")
  if (imageModules[normalized]) return imageModules[normalized].default
  const filename = pathOrFilename.split("/").pop()
  if (filename) {
    const entry = Object.entries(imageModules).find(([k]) =>
      k.endsWith("/" + filename),
    )
    if (entry) return entry[1].default
  }
  return undefined
}

const resolvedPortrait = resolveImage(bio.image)
---

<section
  id="bio"
  class="relative z-10 pt-28 sm:pt-36 pb-16 sm:pb-24 border-b border-neutral-900/10"
>
  <div class="container mx-auto px-4 sm:px-8">
    <!-- Top Editorial Masthead Strip -->
    <div class="bio-masthead flex items-center gap-3 mb-4 font-mono text-xs uppercase tracking-widest text-neutral-500">
      <span class="inline-block size-2 rounded-full bg-purple-500 animate-pulse"></span>
      <span>{t("bio-profile-prefix")}</span>
      <span class="text-neutral-300">/</span>
      <span>{t("bio-location")}</span>
    </div>

    <!-- Big Editorial Headline -->
    <div class="border-b border-neutral-900/15 pb-8 mb-12 sm:mb-16">
      <h1 class="bio-headline font-serif text-5xl sm:text-7xl lg:text-9xl uppercase tracking-tight text-neutral-900 leading-none">
        {bio.name || t("about-eshale-title")}
      </h1>
      <p class="bio-quote mt-3 font-serif text-xl sm:text-3xl italic text-neutral-600 max-w-2xl leading-relaxed">
        "{bio.quote}"
      </p>
    </div>

    <!-- Two-Column Editorial Spread -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left Column: Portrait & Disciplines -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bio-portrait-frame relative aspect-[3/4] w-full overflow-hidden bg-neutral-200 border border-neutral-900/15 shadow-md">
          {resolvedPortrait ? (
            <Picture
              src={resolvedPortrait}
              formats={["avif", "webp"]}
              fallbackFormat="jpg"
              alt={t("bio-portrait-alt")}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-105"
            />
          ) : (
            <img
              src={bio.image}
              alt={t("bio-portrait-alt")}
              loading="eager"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 ease-out hover:scale-105"
            />
          )}
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-neutral-950/80 via-neutral-950/30 to-transparent p-5 text-white">
            <span class="font-mono text-[11px] uppercase tracking-wider block text-neutral-300">
              {bio.imageCaptionRole || t("bio-portrait-badge")}
            </span>
            <span class="font-serif text-lg italic text-white">
              {bio.imageCaptionLocation || t("bio-portrait-sub")}
            </span>
          </div>
        </div>

        <!-- Disciplines Card -->
        <div class="bio-disciplines-card border border-neutral-900/10 p-5 bg-white/70 space-y-3 font-mono text-xs">
          <span class="text-neutral-400 uppercase tracking-widest block text-[10px]">
            {t("bio-disciplines-tag")}
          </span>
          <div class="space-y-3 text-neutral-700">
            {bio.disciplines?.map((item) => (
              <div class="flex items-start gap-2">
                <span class="text-purple-600 font-bold">·</span>
                <div>
                  <strong class="text-neutral-900 block font-sans">
                    {item.title}
                  </strong>
                  <span class="text-neutral-500 text-[11px] leading-relaxed block mt-0.5">
                    {item.description}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Right Column: Biography & Philosophy -->
      <div class="bio-statement-col lg:col-span-7 space-y-8">
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-neutral-400 block mb-2">
            {t("bio-statement-tag")}
          </span>
          <h2 class="font-serif text-3xl sm:text-4xl text-neutral-900 mb-6 leading-tight">
            {bio.statementHeading || t("bio-heading")}
          </h2>
          <div class="space-y-4 font-serif text-base sm:text-lg text-neutral-700 leading-relaxed">
            <p>{bio.statementParagraph1 || t("bio-paragraph-1")}</p>
            <p>{bio.statementParagraph2 || t("bio-paragraph-2")}</p>
          </div>
        </div>

        <blockquote class="bio-statement-quote border-l-2 border-neutral-900 pl-5 my-6 font-serif text-base sm:text-lg italic text-neutral-800 leading-relaxed">
          "{bio.statementQuote}"
        </blockquote>

        <!-- Quick Sequential Navigation Cues -->
        <div class="bio-cta-row pt-6 border-t border-neutral-900/10 flex flex-wrap gap-4">
          <a
            href="#catalogue"
            class="group inline-flex items-center gap-2 rounded-full bg-neutral-950 px-6 py-3 font-mono text-xs uppercase tracking-wider text-white transition-transform hover:scale-[1.02] active:scale-95"
          >
            <span>{t("explore-artworks-cta")}</span>
          </a>
          <a
            href="#fashion"
            class="group inline-flex items-center gap-2 rounded-full border border-neutral-900/20 bg-white px-6 py-3 font-mono text-xs uppercase tracking-wider text-neutral-900 transition-colors hover:bg-neutral-100"
          >
            <span>{t("explore-fashion-cta")}</span>
          </a>
          <a
            href={bio.instagramUrl}
            target="_blank"
            rel="noopener nofollow"
            class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider text-teal-600 hover:underline px-3 py-3"
          >
            <span>{bio.instagramHandle}</span>
            <span>↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
