---
import { Picture } from "astro:assets"
import type { ImageMetadata } from "astro"
import * as bioDoc from "@/content/bio.md"
import type { BioFrontmatter } from "@/types/bio"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"
import { getIssueFormatted, getIssueTag } from "@/utils/issue"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)

const bio: BioFrontmatter = (bioDoc as any).frontmatter as BioFrontmatter

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/img/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP,avif,AVIF}",
  { eager: true },
)

function resolveImage(pathOrFilename?: string): ImageMetadata | undefined {
  if (!pathOrFilename) return undefined
  if (imageModules[pathOrFilename]) return imageModules[pathOrFilename].default
  const normalized = pathOrFilename
    .replace(/^@\//, "/src/")
    .replace(/^src\//, "/src/")
  if (imageModules[normalized]) return imageModules[normalized].default
  const filename = pathOrFilename.split("/").pop()
  if (filename) {
    const entry = Object.entries(imageModules).find(([k]) =>
      k.endsWith("/" + filename),
    )
    if (entry) return entry[1].default
  }
  return undefined
}

const resolvedPortrait = resolveImage(bio.image)
const issueTag = getIssueTag()
const issueFormatted = getIssueFormatted()
---

<section id="bio" class="bio-section relative z-10">
  <!-- 1. FULL VIEWPORT HERO STAGE (Expansive Magazine Composition, Broad Canvas, No Borders/Barcode) -->
  <div
    id="bio-cover-stage"
    class="bio-cover-stage relative min-h-screen min-h-svh min-h-dvh w-full overflow-hidden bg-[#8e88bc] flex flex-col justify-between pt-3 sm:pt-4 md:pt-6 pb-4 sm:pb-6 px-4 sm:px-8 lg:px-12"
    style="background-color: #8e88bc;"
  >
    <!-- Background Portrait Canvas: Centered with respect to viewport -->
    <div
      id="bio-hero-image-container"
      class="absolute inset-0 z-0 flex items-center justify-center overflow-hidden pointer-events-none"
    >
      <div
        id="bio-hero-image-sway"
        class="w-full h-full flex items-center justify-center animate-ethereal-sway will-change-transform"
      >
        {resolvedPortrait ? (
          <Picture
            src={resolvedPortrait}
            formats={["avif", "webp"]}
            fallbackFormat="jpg"
            alt={t("bio-portrait-alt")}
            loading="eager"
            decoding="async"
            class="bio-cover-bg-image h-full w-full object-contain object-center filter drop-shadow-2xl will-change-transform"
          />
        ) : (
          <img
            src={bio.image}
            alt={t("bio-portrait-alt")}
            loading="eager"
            decoding="async"
            class="bio-cover-bg-image h-full w-full object-contain object-center filter drop-shadow-2xl will-change-transform"
          />
        )}
      </div>
    </div>

    <!-- Atmospheric Bottom Vignette Scrim (Grounds blurbs & mobile composition) -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-44 sm:h-56 bg-gradient-to-t from-neutral-950/40 via-neutral-950/10 to-transparent z-10"
      aria-hidden="true"
    ></div>

    <!-- TOP: Masthead "ESHALE" with Framing Information strictly bounded to ESHALE's margins -->
    <div class="bio-cover-header relative z-10 w-full flex justify-center shrink-0 select-none pt-1 sm:pt-2 px-4 sm:px-6">
      <div class="inline-flex flex-col items-stretch relative w-fit max-w-full">
        <!-- Top Right of ESHALE: Coordinates strictly aligned to right margin of ESHALE -->
        <div class="bio-cover-coords flex justify-end w-full mb-0.5 sm:mb-1">
          <span class="font-mono text-[9px] sm:text-[11px] md:text-xs uppercase tracking-widest text-white/90 drop-shadow-sm">
            {bio.coordinates || t("bio-coordinates")}
          </span>
        </div>

        <!-- Masthead "ESHALE" (Broad, Full-Spread, Overlapping Portrait) -->
        <h1
          id="bio-cover-title"
          class="bio-cover-title font-serif text-[18vw] sm:text-[15vw] md:text-[13vw] lg:text-[11vw] uppercase tracking-tighter text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.25)] leading-[0.8] text-center will-change-transform whitespace-nowrap block"
        >
          {bio.name || t("about-eshale-title")}
        </h1>

        <!-- Bottom Footers: Bottom Left = Edition & Vol, Bottom Right = Location (strictly within ESHALE margins) -->
        <div class="bio-cover-topbar flex items-center justify-between w-full mt-1 sm:mt-1.5 font-mono text-[9px] sm:text-[11px] md:text-xs uppercase tracking-widest text-white/95 drop-shadow-sm will-change-transform">
          <span class="font-bold tracking-widest text-left">
            {t("magazine-cover-edition")} {issueFormatted}
          </span>
          <span class="font-medium text-right ml-4">
            {bio.location || t("bio-location")}
          </span>
        </div>
      </div>
    </div>

    <!-- BOTTOM: Blurbs Row (Pushed up) + Centered Scroll Cue Below -->
    <div class="relative z-10 w-full max-w-7xl mx-auto flex flex-col justify-end mt-auto space-y-3 sm:space-y-4">
      <!-- Blurbs Row: Left Blurb on Left, Right Blurb on Right -->
      <div class="flex items-end justify-between gap-4 sm:gap-8 w-full">
        <!-- Left Blurb (Positioned lower on the image stage) -->
        <div
          id="bio-blurb-left"
          class="bio-blurb-left max-w-[200px] sm:max-w-xs md:max-w-sm text-left space-y-1.5 text-white pointer-events-auto will-change-transform"
        >
          <span class="font-mono text-[9px] sm:text-xs uppercase tracking-widest text-white/95 bg-neutral-950/40 px-2 py-0.5 backdrop-blur-xs border border-white/20 inline-block font-bold">
            [{" "}
            <span class="inline-block size-1.5 rounded-full bg-purple-400 animate-pulse align-middle mr-1.5"></span>
            {t("bio-director-tag")} ]
          </span>
          <p class="font-serif italic text-xs sm:text-sm md:text-base text-white leading-relaxed drop-shadow-[0_2px_8px_rgba(0,0,0,0.6)] line-clamp-3">
            "{bio.quote}"
          </p>
        </div>

        <!-- Right Blurb (Positioned lower on the image stage) -->
        <div
          id="bio-blurb-right"
          class="bio-blurb-right max-w-[200px] sm:max-w-xs md:max-w-sm text-right space-y-1.5 text-white pointer-events-auto will-change-transform font-mono text-[9px] sm:text-xs uppercase tracking-widest"
        >
          <span class="bg-neutral-950/40 px-2 py-0.5 backdrop-blur-xs border border-white/20 font-bold inline-block">
            {issueTag}
          </span>
          <span class="block text-white/90 drop-shadow-[0_2px_8px_rgba(0,0,0,0.6)]">
            {t("bio-archive-tag")}
          </span>
          <span class="block text-white font-bold drop-shadow-[0_2px_8px_rgba(0,0,0,0.6)]">
            {t("bio-atelier-tag")}
          </span>
        </div>
      </div>

      <!-- Centered Scroll Cue: Placed Below Blurbs, 100% Horizontally Centered across Stage -->
      <div
        id="bio-scroll-cue"
        class="bio-scroll-cue flex flex-col items-center justify-center gap-1 font-mono text-[9px] sm:text-[11px] uppercase tracking-widest text-white/90 text-center will-change-transform pt-1 sm:pt-2"
      >
        <span class="inline-block animate-bounce text-sm">↓</span>
        <span>{t("magazine-scroll-cue")}</span>
      </div>
    </div>
  </div>

  <!-- 2. STREAMLINED EDITORIAL DOSSIER SECTION (No Redundancies, High Impact) -->
  <div
    id="bio-settled-section"
    class="bio-settled-section relative z-10 bg-[#faf9f6] border-t border-neutral-900/15 py-16 sm:py-20"
  >
    <div class="container mx-auto px-4 sm:px-8">
      <!-- Streamlined Header Strip: Title + 3-Cell Stats Module -->
      <div
        id="bio-settled-anchor"
        class="border-b border-neutral-900/15 pb-8 mb-10 sm:mb-14 flex flex-col lg:flex-row lg:items-end justify-between gap-6"
      >
        <div>
          <span class="font-mono text-xs uppercase tracking-widest text-neutral-400 block mb-2">
            [{" "}
            <span class="inline-block size-1.5 rounded-full bg-purple-500 animate-pulse align-middle mr-1.5"></span>
            {t("bio-dossier-headline-tag")} ]
          </span>
          <h2 class="bio-settled-headline font-serif text-5xl sm:text-7xl lg:text-8xl uppercase tracking-tighter text-neutral-950 leading-none">
            {bio.name || t("about-eshale-title")}
          </h2>
        </div>

        <!-- 3-Cell Architectural Stats Module in Header Strip -->
        <div class="grid grid-cols-3 border border-neutral-900/15 divide-x divide-neutral-900/15 bg-white/70 font-mono shadow-xs shrink-0 max-w-md w-full lg:w-auto">
          {bio.stats ? (
            bio.stats.map((st) => (
              <div class="p-3.5 sm:p-4 text-center">
                <span class="block text-lg sm:text-xl font-bold font-serif text-neutral-950 mb-0.5">
                  {st.val}
                </span>
                <span class="block text-[9px] uppercase tracking-wider text-neutral-500">
                  {st.label}
                </span>
              </div>
            ))
          ) : (
            <>
              <div class="p-3.5 sm:p-4 text-center">
                <span class="block text-xl font-bold font-serif text-neutral-950 mb-0.5">
                  03
                </span>
                <span class="block text-[9px] uppercase tracking-wider text-neutral-500">
                  DISCIPLINES
                </span>
              </div>
              <div class="p-3.5 sm:p-4 text-center">
                <span class="block text-xl font-bold font-serif text-neutral-950 mb-0.5">
                  2022
                </span>
                <span class="block text-[9px] uppercase tracking-wider text-neutral-500">
                  ESTABLISHED
                </span>
              </div>
              <div class="p-3.5 sm:p-4 text-center">
                <span class="block text-xl font-bold font-serif text-neutral-950 mb-0.5">
                  VOL. I & II
                </span>
                <span class="block text-[9px] uppercase tracking-wider text-neutral-500">
                  EDITIONS
                </span>
              </div>
            </>
          )}
        </div>
      </div>

      <!-- Two-Column Architectural Spread -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start pb-14">
        <!-- Left Column: Concept Manifesto Block & Quick Sequential CTAs -->
        <div class="lg:col-span-5 space-y-6">
          <!-- ICONIC CONCEPT MANIFESTO BLOCK -->
          <div class="bio-manifesto-block border border-neutral-900/20 bg-neutral-900/[0.03] p-6 sm:p-8 relative overflow-hidden">
            <div class="flex items-center justify-between mb-4 font-mono text-[10px] uppercase tracking-widest text-neutral-500">
              <span>
                [{" "}
                <span class="inline-block size-1.5 rounded-full bg-purple-500 animate-pulse align-middle mr-1.5"></span>
                {bio.manifestoTag || t("bio-core-ethos-tag")} ]
              </span>
              <span>{t("bio-atelier-brand")}</span>
            </div>
            <h3 class="font-serif text-2xl sm:text-4xl uppercase tracking-tight text-neutral-950 mb-3 leading-tight">
              {bio.manifestoTitle || t("bio-core-ethos-title")}
            </h3>
            <p class="font-serif text-sm sm:text-base italic text-neutral-700 leading-relaxed">
              "{bio.manifestoText || t("bio-core-ethos-text")}"
            </p>
          </div>

          <!-- Quick Sequential CTAs -->
          <div class="pt-2 flex flex-wrap gap-3">
            <a
              href="#catalogue"
              class="group inline-flex items-center gap-2 rounded-full bg-neutral-950 px-6 py-3 font-mono text-xs uppercase tracking-wider text-white shadow-sm transition-transform hover:scale-[1.02] active:scale-95"
            >
              <span>{t("explore-artworks-cta")}</span>
            </a>
            <a
              href="#fashion"
              class="group inline-flex items-center gap-2 rounded-full border border-neutral-900/25 bg-white px-6 py-3 font-mono text-xs uppercase tracking-wider text-neutral-950 transition-colors hover:bg-neutral-100"
            >
              <span>{t("explore-fashion-cta")}</span>
            </a>
            <a
              href={bio.instagramUrl}
              target="_blank"
              rel="noopener nofollow"
              class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider text-teal-700 hover:underline px-2 py-3"
            >
              <span>{bio.instagramHandle}</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Narrative Philosophy & Statement Quote -->
        <div class="bio-statement-col lg:col-span-7 space-y-6">
          <div>
            <span class="font-mono text-xs uppercase tracking-widest text-neutral-400 block mb-2">
              [{" "}
              <span class="inline-block size-1.5 rounded-full bg-purple-500 animate-pulse align-middle mr-1.5"></span>
              {t("bio-statement-tag")} ]
            </span>
            <h3 class="font-serif text-2xl sm:text-3xl text-neutral-950 mb-4 leading-tight">
              {bio.statementHeading || t("bio-heading")}
            </h3>
            <div class="space-y-4 font-serif text-base sm:text-lg text-neutral-700 leading-relaxed">
              <p class="first-letter:float-left first-letter:text-5xl sm:first-letter:text-6xl first-letter:font-serif first-letter:font-bold first-letter:mr-3.5 first-letter:leading-[0.8] first-letter:text-neutral-950 first-letter:pt-1">
                {bio.statementParagraph1 || t("bio-paragraph-1")}
              </p>
              <p>{bio.statementParagraph2 || t("bio-paragraph-2")}</p>
            </div>
          </div>

          <!-- Bold High-Fashion Pull Quote -->
          <blockquote class="border-l-2 border-neutral-950 pl-5 my-4 font-serif text-base sm:text-lg italic text-neutral-900 leading-relaxed">
            "{bio.statementQuote}"
          </blockquote>
        </div>
      </div>

      <!-- ARCHITECTURAL DISCIPLINES DOSSIER (3-Column Structured Grid) -->
      <div class="border-t border-neutral-900/15 pt-8">
        <div class="flex items-center justify-between mb-6 font-mono text-xs uppercase tracking-widest text-neutral-500">
          <span>
            [{" "}
            <span class="inline-block size-1.5 rounded-full bg-purple-500 animate-pulse align-middle mr-1.5"></span>
            {t("bio-dossier-tag")} ]
          </span>
          <span class="hidden sm:inline">{t("bio-disciplines-count")}</span>
        </div>

        <div class="bio-disciplines-grid grid grid-cols-1 md:grid-cols-3 border border-neutral-900/15 divide-y md:divide-y-0 md:divide-x divide-neutral-900/15 bg-white/60 shadow-xs">
          {bio.disciplines?.map((item, idx) => (
            <div class="p-6 sm:p-8 flex flex-col justify-between space-y-4 hover:bg-white transition-colors">
              <div>
                <span class="font-mono text-xs text-neutral-400 block mb-2">
                  [ 0{idx + 1} // {t("bio-practice-tag")} ]
                </span>
                <h4 class="font-serif text-2xl text-neutral-900 mb-2">
                  {item.title}
                </h4>
                <p class="font-serif text-sm text-neutral-600 leading-relaxed">
                  {item.description}
                </p>
              </div>
              <div class="pt-4 border-t border-neutral-900/10 flex items-center justify-between font-mono text-[10px] uppercase text-neutral-400">
                <span>{t("bio-atelier-brand")}</span>
                <span>✦</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
