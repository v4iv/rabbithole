---
import InstagramIcon from "@/assets/instagram.svg"
import WhatsAppIcon from "@/assets/whatsapp.svg"
import EmailIcon from "@/assets/email.svg"
import GoogleMapsIcon from "@/assets/googlemaps.svg"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<div class="social-links-bar pointer-events-auto flex items-center justify-center gap-2">
  <a
    aria-label={t("instagram")}
    href="https://instagram.com/rabbitholeartstudio"
    target="_blank"
    rel="noopener nofollow"
    class="social-link-btn group relative cursor-pointer rounded-full bg-neutral-950 p-3.5 sm:p-4 shadow-md transition-colors hover:bg-neutral-700"
  >
    <InstagramIcon
      fill="#ffffff"
      class="pointer-events-none size-5 sm:size-6 transition-transform duration-200"
    />
  </a>
  <button
    type="button"
    data-contact-action="whatsapp"
    aria-label={t("whatsapp")}
    class="social-link-btn group relative cursor-pointer rounded-full bg-neutral-950 p-3.5 sm:p-4 shadow-md transition-colors hover:bg-neutral-700"
  >
    <WhatsAppIcon
      fill="#ffffff"
      class="pointer-events-none size-5 sm:size-6 transition-transform duration-200"
    />
  </button>
  <button
    type="button"
    data-contact-action="email"
    aria-label={t("email")}
    class="social-link-btn group relative cursor-pointer rounded-full bg-neutral-950 p-3.5 sm:p-4 shadow-md transition-colors hover:bg-neutral-700"
  >
    <EmailIcon
      fill="#ffffff"
      class="pointer-events-none size-5 sm:size-6 transition-transform duration-200"
    />
  </button>
  <a
    aria-label={t("maps")}
    href="https://maps.app.goo.gl/kxsoMwDU5pPwvopx6"
    target="_blank"
    rel="noopener nofollow"
    class="social-link-btn group relative cursor-pointer rounded-full bg-neutral-950 p-3.5 sm:p-4 shadow-md transition-colors hover:bg-neutral-700"
  >
    <GoogleMapsIcon
      fill="#ffffff"
      class="pointer-events-none size-5 sm:size-6 transition-transform duration-200"
    />
  </a>
</div>
