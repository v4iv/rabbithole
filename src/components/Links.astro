---
import InstagramIcon from "@/assets/instagram.svg"
import WhatsAppIcon from "@/assets/whatsapp.svg"
import EmailIcon from "@/assets/email.svg"
import GoogleMapsIcon from "@/assets/googlemaps.svg"
import { getLangFromUrl, useTranslations } from "@/i18n/utils"

const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
---

<div class="absolute bottom-8 flex w-full items-center justify-center gap-2">
  <a
    aria-label={t("instagram")}
    href="https://instagram.com/rabbitholeartstudio"
    target="_blank"
    rel="noopener nofollow"
    class="rounded-full bg-neutral-950 p-4 hover:bg-neutral-600"
  >
    <InstagramIcon fill="#ffffff" class="size-6" />
  </a>
  <a
    aria-label={t("whatsapp")}
    href="https://wa.me/917986588875"
    target="_blank"
    rel="noopener nofollow"
    class="rounded-full bg-neutral-950 p-4 hover:bg-neutral-600"
  >
    <WhatsAppIcon fill="#ffffff" class="size-6" />
  </a>
  <a
    aria-label={t("email")}
    href="mailto:artstudiorabbithole@gmail.com"
    target="_blank"
    rel="noopener nofollow"
    class="rounded-full bg-neutral-950 p-4 hover:bg-neutral-600"
  >
    <EmailIcon fill="#ffffff" class="size-6" />
  </a>
  <a
    aria-label={t("maps")}
    href="https://maps.app.goo.gl/kxsoMwDU5pPwvopx6"
    target="_blank"
    rel="noopener nofollow"
    class="rounded-full bg-neutral-950 p-4 hover:bg-neutral-600"
  >
    <GoogleMapsIcon fill="#ffffff" class="size-6" />
  </a>
</div>
